<style>
  @page { size: A4; margin: 16mm 15mm 19mm; }
  * { box-sizing: border-box; }
  body { margin: 0; color: #17212b; background: #fff; font: 10pt Arial, sans-serif; line-height: 1.45; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 5px; color: #0b3026; font-size: 23pt; letter-spacing: -.4px; }
  h2 { margin: 22px 0 9px; color: #153d32; font-size: 13pt; border-bottom: 1px solid #cbdcd6; padding-bottom: 5px; }
  h3 { color: #245247; font-size: 10pt; margin-bottom: 4px; }
  .brand { color: #087754; font-size: 9pt; font-weight: bold; letter-spacing: 1.6px; text-transform: uppercase; }
  .subtitle, .meta, .muted { color: #66756f; }
  .meta { margin: 10px 0 17px; font-size: 8.5pt; }
  .metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 7px; margin: 13px 0; }
  .metric { border: 1px solid #cfe0da; border-radius: 6px; background: #f3f8f6; padding: 9px; }
  .metric span { display: block; color: #64756f; font-size: 7pt; letter-spacing: .6px; text-transform: uppercase; }
  .metric strong { display: block; color: #0a6649; font-size: 13pt; margin-top: 4px; }
  .summary-box { border-left: 4px solid #18a474; background: #f1faf6; padding: 11px 13px; margin: 12px 0; }
  table { width: 100%; border-collapse: collapse; font-size: 8.3pt; }
  th { color: #46635a; background: #eef5f2; font-size: 7pt; letter-spacing: .4px; text-align: left; text-transform: uppercase; }
  th, td { border-bottom: 1px solid #dce7e3; padding: 6px 5px; vertical-align: top; }
  td.numeric, th.numeric { text-align: right; }
  .pill { display: inline-block; border-radius: 9px; padding: 2px 6px; background: #e3f4ed; color: #087754; font-size: 7pt; }
  .binding { color: #9b4e08; background: #fff1df; }
  .constraint-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 14px; }
  .constraint-grid div { border-bottom: 1px solid #e1ebe7; padding: 5px 0; }
  .constraint-grid span { color: #64756f; }
  .constraint-grid strong { float: right; }
  .prose-item { break-inside: avoid; border-bottom: 1px solid #dfe9e5; margin-bottom: 9px; padding-bottom: 8px; }
  .prose-item p { margin-bottom: 3px; }
  .insight { break-inside: avoid; border: 1px solid #f0d7b9; background: #fff9f1; padding: 9px; margin: 6px 0; }
  .page-break { break-before: page; }
  .disclaimer { color: #5e6965; border-top: 1px solid #bccbc6; margin: 19px 0 0; padding-top: 8px; font-size: 7.2pt; line-height: 1.35; }
  .summary-report h2 { margin-top: 13px; }
  .summary-report table { font-size: 7.7pt; }
  .summary-report th, .summary-report td { padding: 4px; }
</style>
