title: OptiVest — From Investor Intent to Auditable Portfolio Decisions
---
flowchart TB
    subgraph ACCESS["01 · EXPERIENCE AND SECURE API"]
        direction TB
        USER(["<b>INVESTOR / FACULTY REVIEWER</b><br/>configures · compares · validates"]):::external
        UI["<b>REACT 19 + TYPESCRIPT 5.9</b><br/>Vite · React Query · typed API client"]:::frontend
        API["<b>FASTAPI + PYDANTIC</b><br/>JWT authentication · ownership checks"]:::service
        SVC["<b>SERVICE ORCHESTRATION</b><br/>async sessions · background-task scheduling"]:::service

        USER --> UI
        UI -->|JWT + JSON| API
        API --> SVC
    end

    subgraph INTELLIGENCE["02 · DECISION INTELLIGENCE"]
        direction TB
        subgraph AILAYER["AI / PERSONALIZATION LAYER · additive and optional"]
            direction LR
            ML["<b>ML FORECASTING</b><br/>Gradient Boosting return model"]:::ai
            PERS["<b>PERSONALIZATION</b><br/>Logistic Regression risk profile"]:::ai
            AST["<b>GROUNDED ASSISTANT</b><br/>TF-IDF + Logistic Regression intents"]:::ai
            ALT["<b>PERSONALIZED ALERTS</b><br/>drift rules + Isolation Forest"]:::ai
        end

        subgraph ORCORE["OPERATIONS RESEARCH CORE · authoritative decision engine"]
            direction LR
            OPT["<b>OPTIMIZATION</b><br/>SciPy SLSQP · PuLP/CBC · OR-Tools CP-SAT"]:::orcore
            EXP["<b>EXPLAINABILITY</b><br/>constraints · contributions · narratives"]:::orcore
            SCN["<b>SCENARIO SIMULATOR</b><br/>seven shock transforms + re-solve"]:::orcore
            ANA["<b>VALIDATED ANALYTICS</b><br/>OOS backtests · frontier · risk metrics"]:::orcore
            REP["<b>PDF REPORTS</b><br/>Jinja2 + WeasyPrint"]:::orcore
        end
    end

    subgraph FOUNDATION["03 · AUDITED DATA FOUNDATION"]
        direction LR
        CSV["<b>KAGGLE NIFTY DATA</b><br/>287,310 raw rows"]:::external
        ETL["<b>IDEMPOTENT ETL</b><br/>prices · fundamentals · technicals"]:::data
        DB[("<b>POSTGRESQL 16</b><br/>21 application tables")]:::data

        CSV --> ETL --> DB
    end

    SVC --> OPT
    SVC --> EXP
    SVC --> SCN
    SVC --> ANA
    SVC --> REP
    SVC --> ML
    SVC --> PERS
    SVC --> AST
    SVC -. post-response .-> ALT
    ML -->|optional mu| OPT
    PERS -->|editable defaults| OPT
    AST -->|grounded evidence| EXP
    AST -->|real re-solves| SCN
    SVC -->|async SQLAlchemy transactions| DB

    subgraph KEY["VISUAL KEY"]
        direction LR
        KOR["OR CORE"]:::orcore
        KAI["AI LAYER"]:::ai
        KDATA["DATA"]:::data
        KEDGE["USER / INPUT"]:::external
    end

    DB ~~~ KOR

