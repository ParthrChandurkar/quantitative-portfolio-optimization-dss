---
title: OptiVest Intelligence Pipeline — AI Enhances, OR Decides
---
flowchart TB
    DB[("<b>REAL MARKET DATA</b><br/>prices · technicals · fundamentals")]:::data
    ANSWERS["<b>INVESTOR PROFILE</b><br/>six-answer questionnaire"]:::external
    QUESTION["<b>PORTFOLIO QUESTION</b><br/>natural-language input"]:::external

    subgraph AIMODELS["01 · AI MODELS AND PERSONALIZATION"]
        direction LR
        FEATURES["<b>SHARED FEATURES</b><br/>ml/features.py · 12 market signals"]:::ai
        FORECAST["<b>RETURN FORECASTER</b><br/>GradientBoostingRegressor"]:::ai
        RISK["<b>RISK CLASSIFIER</b><br/>multinomial Logistic Regression"]:::ai
        INTENT["<b>INTENT CLASSIFIER</b><br/>TF-IDF + Logistic Regression"]:::ai
        ANOMALY["<b>ANOMALY DETECTOR</b><br/>per-stock Isolation Forest"]:::ai
    end

    subgraph ORCORE["02 · OPERATIONS RESEARCH CORE · AUTHORITATIVE"]
        direction LR
        SCENARIOS["<b>SCENARIO SIMULATOR</b><br/>shock transform"]:::orcore
        OPT["<b>OPTIMIZER</b><br/>historical mean or optional ML mu"]:::orcore
        EXPLAIN["<b>EXPLAINABILITY</b><br/>reasons + constraints"]:::orcore
        ANALYTICS["<b>VALIDATED ANALYTICS</b><br/>OOS backtest + risk + frontier"]:::orcore

        SCENARIOS -->|re-solve| OPT
        OPT --> EXPLAIN
        OPT --> ANALYTICS
    end

    SNAPSHOT[("<b>AUDITABLE OR OUTPUTS</b><br/>snapshot · explanations · analytics")]:::data

    subgraph AIEXPERIENCES["03 · GROUNDED AI EXPERIENCES"]
        direction LR
        ASSISTANT["<b>GROUNDED ANSWERS</b><br/>deterministic templates only"]:::ai
        ALERTS["<b>PERSONALIZED ALERTS</b><br/>deduplicated + numerically grounded"]:::ai
    end

    UI["<b>PERSONALIZED DECISION SUPPORT</b><br/>defaults · answers · alerts"]:::frontend

    DB --> FEATURES
    FEATURES --> FORECAST
    FEATURES --> ANOMALY
    ANSWERS --> RISK
    QUESTION --> INTENT
    FORECAST -->|optional ML mu| OPT
    RISK -->|editable OR defaults| OPT
    INTENT -->|shock intent| SCENARIOS
    EXPLAIN --> SNAPSHOT
    ANALYTICS --> SNAPSHOT
    SNAPSHOT --> ASSISTANT
    INTENT --> ASSISTANT
    ANOMALY --> ALERTS
    SNAPSHOT --> ALERTS
    RISK -->|visible recommendation| UI
    ASSISTANT --> UI
    ALERTS --> UI

    subgraph KEY["VISUAL KEY"]
        direction LR
        KOR["OR CORE"]:::orcore
        KAI["AI / ML"]:::ai
        KDATA["REAL DATA"]:::data
        KUI["USER OUTCOME"]:::frontend
    end

