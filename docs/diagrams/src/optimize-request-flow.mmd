---
title: POST /portfolios/{id}/optimize — Request Flow
---
flowchart LR
    REQ(["React client<br/>constraints + INR budget"]):::external
    ROUTE["FastAPI route<br/>auth + ownership"]:::sync
    SERVICE["optimization_service<br/>optimize_portfolio()"]:::sync
    BUILD["Build inputs<br/>mu · Sigma · constraints"]:::sync
    SOLVE["engine.solve()<br/>selected OR solver"]:::orcore
    EXPLAIN["build_explanations()<br/>reasons + constraints"]:::orcore
    WRITE["Persist full solution<br/>run · snapshot · holdings"]:::data
    RESPONSE["Solved response<br/>snapshot ID + explanations"]:::positive
    UI(["React holdings<br/>and Why? panel"]):::external
    DB[("PostgreSQL 16")]:::data

    REQ --> ROUTE --> SERVICE --> BUILD
    BUILD --> SOLVE --> EXPLAIN --> WRITE
    WRITE --> RESPONSE --> UI
    BUILD <-->|market + portfolio reads| DB
    WRITE -->|atomic commit| DB

    ALERT["FastAPI BackgroundTask<br/>check_alerts_in_background()"]:::background
    DETECT["Risk drift + held-stock<br/>anomaly checks"]:::background
    ALERTDB["Persist deduplicated alerts<br/>GET /me/alerts"]:::data

    RESPONSE -. "after response" .-> ALERT
    ALERT -.-> DETECT
    DETECT -.-> DB
    DETECT -.-> ALERTDB
    ALERTDB -.-> DB

    subgraph KEY["Legend"]
        direction TB
        KSYNC["Synchronous request path"]:::sync
        KOR["OR / explainability"]:::orcore
        KBG["Post-response background path"]:::background
        KDATA["Persistence"]:::data
    end

    DB ~~~ KSYNC

