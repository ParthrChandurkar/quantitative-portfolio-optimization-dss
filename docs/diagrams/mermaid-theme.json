{
  "theme": "base",
  "look": "classic",
  "themeCSS": ".node rect,.node polygon,.node path,.node circle,.node ellipse{filter:drop-shadow(0 3px 7px rgba(11,14,19,.12));}.node rect{rx:10px;ry:10px}.cluster rect{rx:16px;ry:16px;filter:drop-shadow(0 4px 12px rgba(11,14,19,.07))}.cluster-label text,.cluster-label span{font-weight:700!important;letter-spacing:.035em}.titleText,.erDiagramTitleText{font-weight:800!important;font-size:22px!important;letter-spacing:.01em}.flowchart-link,.relationshipLine{stroke-width:2px!important}.edgeLabel{font-weight:600!important;background-color:#fff!important;border-radius:6px;padding:2px 6px}.nodeLabel{line-height:1.38}.erDiagram .node rect{filter:drop-shadow(0 3px 7px rgba(11,14,19,.10))}.erDiagram .nodeLabel{font-weight:600}",
  "themeVariables": {
    "background": "#F7F8FA",
    "fontFamily": "Inter, Segoe UI, Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#EAF1FF",
    "primaryTextColor": "#0B0E13",
    "primaryBorderColor": "#3E7BFA",
    "secondaryColor": "#FFF4DC",
    "secondaryTextColor": "#0B0E13",
    "secondaryBorderColor": "#F59E0B",
    "tertiaryColor": "#EAF9EF",
    "tertiaryTextColor": "#0B0E13",
    "tertiaryBorderColor": "#22C55E",
    "lineColor": "#526071",
    "textColor": "#0B0E13",
    "darkTextColor": "#E7E9EE",
    "errorBkgColor": "#FDECEC",
    "errorTextColor": "#EF4444",
    "mainBkg": "#FFFFFF",
    "nodeBorder": "#3E7BFA",
    "clusterBkg": "#F7F8FA",
    "clusterBorder": "#CBD5E1",
    "titleColor": "#0B0E13",
    "edgeLabelBackground": "#FFFFFF",
    "actorBkg": "#EAF1FF",
    "actorBorder": "#3E7BFA",
    "actorTextColor": "#0B0E13",
    "actorLineColor": "#94A3B8",
    "signalColor": "#334155",
    "signalTextColor": "#0B0E13",
    "labelBoxBkgColor": "#FFFFFF",
    "labelBoxBorderColor": "#CBD5E1",
    "labelTextColor": "#0B0E13",
    "loopTextColor": "#0B0E13",
    "noteBkgColor": "#FFF4DC",
    "noteBorderColor": "#F59E0B",
    "noteTextColor": "#0B0E13",
    "activationBkgColor": "#EAF9EF",
    "activationBorderColor": "#22C55E",
    "cScale0": "#EAF1FF",
    "cScale1": "#FFF4DC",
    "cScale2": "#EAF9EF",
    "cScale3": "#FDECEC",
    "cScaleLabel0": "#0B0E13",
    "cScaleLabel1": "#0B0E13",
    "cScaleLabel2": "#0B0E13",
    "cScaleLabel3": "#0B0E13"
  },
  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "nodeSpacing": 42,
    "rankSpacing": 58,
    "padding": 14,
    "useMaxWidth": true
  },
  "er": {
    "diagramPadding": 24,
    "layoutDirection": "TB",
    "minEntityWidth": 120,
    "minEntityHeight": 60,
    "entityPadding": 12,
    "stroke": "#526071",
    "fill": "#FFFFFF",
    "fontSize": 13,
    "useMaxWidth": true
  }
}
